# Copy to .env. Optional settings and their defaults are listed in the README.
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Stripe Dashboard credentials and the webhook endpoint's signing secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Load demo data for a host-run backend.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# Set this for an externally hosted storefront.
# PUBLIC_URL=http://localhost:3000
