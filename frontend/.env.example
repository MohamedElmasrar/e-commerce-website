# Base URL the browser uses for API calls. Leave empty to use the same-origin
# proxy defined in next.config.ts (recommended, keeps the refresh cookie first-party).
NEXT_PUBLIC_API_URL=

# Backend base URL. Server Components read it at request time; the /api/v1 proxy rewrite
# in next.config.ts reads it at BUILD time, so set it before `pnpm build` as well.
API_URL=http://localhost:8080
